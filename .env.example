# Connection string de um projeto Postgres no Neon (neon.tech) — grátis.
# Pegue em: Neon Console -> seu projeto -> Connect -> "Connection string"
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require"

# Gere uma chave própria com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# Token de leitura/escrita de um Blob Store da Vercel (Storage -> Create Database -> Blob).
# Na Vercel, é injetado automaticamente quando o Blob Store é conectado ao projeto.
# Para rodar localmente, copie o token gerado no painel da Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
